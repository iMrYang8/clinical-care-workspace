{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "\"$npm_execpath\" ../node_modules/vite/bin/vite.js",
    "build": "tsc -p tsconfig.build.json && \"$npm_execpath\" ../node_modules/vite/bin/vite.js build",
    "typecheck": "tsc -p tsconfig.build.json",
    "lint": "biome check --no-errors-on-unmatched --files-ignore-unknown=true ./",
    "lint:fix": "biome check --write --unsafe --no-errors-on-unmatched --files-ignore-unknown=true ./",
    "preview": "\"$npm_execpath\" ../node_modules/vite/bin/vite.js preview",
    "generate-client": "openapi-ts",
    "test": "\"$npm_execpath\" ../node_modules/vitest/vitest.mjs run",
    "test:watch": "\"$npm_execpath\" ../node_modules/vitest/vitest.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
