# Enable development behavior for commands that import the app directly
FASTAPI_ENV=development
ENABLE_DEMO_AUTH=true

PROJECT_NAME="Nightingale"
FRONTEND_HOST=https://localhost
BROWSER_TRUSTED_ORIGINS=https://localhost

SECRET_KEY=
# Synthetic development-only key. Production uses an independent persisted secret.
FIELD_ENCRYPTION_MASTER_KEY=
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=

# Emails
SMTP_HOST=localhost
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=False
SMTP_PORT=1025

# Postgres
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=
# Application traffic always uses the LOGIN NOSUPERUSER NOBYPASSRLS role.
DATABASE_URL=postgresql+psycopg://app:${POSTGRES_APP_PASSWORD}@db:5432/app
# Only Alembic, fixture reset, and local one-shot bootstrap read this URL.
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:${POSTGRES_PASSWORD}@db:5432/app

# AI trust boundary. Blank model/key values are ignored; no secret is committed.
AI_PROVIDER=deterministic
VOICE_TRANSCRIPTION_PROVIDER=disabled
REMOTE_AUDIO_EGRESS_ENABLED=false
STRICT_NO_AUDIO_EGRESS=false
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe-diarize
LOCAL_ASR_MODEL_DIR=
PYANNOTE_ENABLED=false
PYANNOTE_MODEL_DIR=
LIVE_TRANSCRIPT_ENABLED=false
LIVE_TRANSCRIPT_PROVIDER=disabled
OPENAI_LIVE_TRANSCRIBE_MODEL=
LIVE_TRANSCRIPT_MAX_BYTES_PER_SECOND=65536
LIVE_TRANSCRIPT_MAX_GLOBAL_CONNECTIONS=8
LIVE_TRANSCRIPT_MAX_CLINIC_CONNECTIONS=8
LIVE_TRANSCRIPT_MAX_USER_CONNECTIONS=2
REMOTE_TEXT_EGRESS_ENABLED=false
OPENAI_API_KEY=
OPENAI_EXTRACT_MODEL=gpt-5.1
OPENAI_REVIEW_MODEL=
AI_JOB_LEASE_SECONDS=300
AI_WORKER_POLL_SECONDS=2
PRESIDIO_REQUIRED=true
PRESIDIO_NLP_MODEL=en_core_web_sm
# Default demo image is model-free. Set true only for a production remote-egress
# image; startup then requires the locked PRESIDIO_NLP_MODEL to load.
INSTALL_PRESIDIO_NLP=false
INSTALL_LOCAL_ASR=false
INSTALL_DIARIZATION=false

# Bounded clinic learning and encrypted retention defaults.
IMPORTANCE_LEARNING_ENABLED=true
DATA_DECAY_ENABLED=true
DATA_DECAY_DRY_RUN=true
